{
  "region_name": "haidian",
  "display_name": "北京海淀",
  "crs": "EPSG:32650",

  "bbox": {
    "west": 116.05,
    "south": 39.88,
    "east": 116.38,
    "north": 40.15
  },

  "time_range": {
    "start": "2025-01-01",
    "end": "2026-05-31"
  },

  "patch": {
    "size_m": 1280,
    "step_m": 1280,
    "image_size_px": 128
  },

  "output_dir": "/workspace/raw/phase2_haidian/haidian_scenes",
  "cloud_filtered_dir": "/workspace/raw/phase2_haidian/haidian_scenes_cloud_filtered",
  "statistics_dir": "/workspace/statistics/haidian_scenes",

  "sources": {
    "s2": {
      "enabled": true,
      "download_source": "gee",
      "collection": "COPERNICUS/S2_SR_HARMONIZED",
      "bands": ["B2", "B3", "B4", "B8A", "B11", "B12"],
      "resolution_m": 10,
      "cloud_filter": {
        "enabled": true,
        "max_per_month": 2,
        "cloud_threshold": 0.3,
        "s2_cloud_prob_max": 70
      }
    },
    "s1": {
      "enabled": true,
      "download_source": "gee",
      "collection": "COPERNICUS/S1_GRD",
      "bands": ["VV", "VH"],
      "resolution_m": 10,
      "cloud_filter": {"enabled": false}
    },
    "landsat": {
      "enabled": true,
      "download_source": "gee",
      "collection": "LANDSAT/LC08/C02/T1_L2",
      "bands": ["SR_B2", "SR_B3", "SR_B4", "SR_B5", "SR_B6", "SR_B7"],
      "resolution_m": 30,
      "cloud_filter": {
        "enabled": true,
        "max_cloud_cover": 70
      }
    },
    "dem": {
      "enabled": true,
      "download_source": "gee",
      "collection": "NASA/NASADEM_HGT/001",
      "bands": ["elevation"],
      "resolution_m": 30,
      "cloud_filter": {"enabled": false}
    },
    "worldcover": {
      "enabled": true,
      "download_source": "gee",
      "collection": "ESA/WorldCover/v200",
      "bands": ["Map"],
      "resolution_m": 10,
      "resampling": "nearest",
      "cloud_filter": {"enabled": false}
    },
    "dynamic_world": {
      "enabled": false,
      "comment": "海淀 phase2 暂不下载，训练时自动跳过"
    },
    "jrc_water": {
      "enabled": false,
      "comment": "海淀 phase2 暂不下载，训练时自动跳过"
    },
    "sar": {
      "enabled": true,
      "download_source": "local",
      "role": ["input", "reconstruction_target"],
      "local_raw_dir": "/workspace/raw/haidian_sar",
      "local_format": "sar_slc_zip",
      "product_types": ["SLC", "ORG"],
      "polarizations": ["VV"],
      "satellites": ["BC3", "BC4"],
      "resolution_m": 3,
      "comment": "干涉 SAR SLC 产品，ZIP 包，需先 unzip+geocode 再切 patch"
    }
  },

  "credentials": {
    "gee": {
      "credentials_path_env": "GEE_CREDENTIALS_PATH",
      "service_account_env": "GEE_SERVICE_ACCOUNT"
    }
  }
}
