      "resolution_m": 30,
      "cloud_filter": {
        "enabled": true,
        "max_cloud_cover": 70
      }
    },
    "dem": {
      "enabled": true,
      "download_source": "gee",
      "collection": "NASA/NASADEM_HGT/001",
      "bands": ["elevation"],
      "resolution_m": 30,
      "cloud_filter": {"enabled": false}
    },
    "worldcover": {
      "enabled": true,
      "download_source": "gee",
      "collection": "ESA/WorldCover/v200",
      "bands": ["Map"],
      "resolution_m": 10,
      "resampling": "nearest",
      "cloud_filter": {"enabled": false}
    },
    "dynamic_world": {
      "enabled": false,
      "comment": "海淀 phase2 暂不下载，训练时自动跳过"
    },
    "jrc_water": {
      "enabled": false,
      "comment": "海淀 phase2 暂不下载，训练时自动跳过"
    },
    "sar": {
      "enabled": true,
      "download_source": "local",
      "role": ["input", "reconstruction_target"],
      "local_raw_dir": "/workspace/raw/haidian_sar",
      "local_format": "sar_slc_zip",
      "product_types": ["SLC", "ORG"],
      "polarizations": ["VV"],
      "satellites": ["BC3", "BC4", "BC5"],
      "resolution_m": 3,
      "site_bboxes": {
        "点位1_干涉":   [116.0298, 39.9279, 116.3922, 40.1927],
        "点位2_干涉":   [116.2723, 39.7036, 116.6509, 39.9832],
        "朝阳角反":     [116.2233, 39.8159, 116.6032, 40.1160],
        "门头沟大台_干涉": [115.7915, 39.7923, 116.1323, 40.0552]
      },
      "comment": "干涉 SAR SLC/ORG ZIP；4个点位共 ~598 个ZIP，~288GB；每个 ZIP 覆盖一个轨道幅"
    }
  },

  "credentials": {
    "gee": {
      "credentials_path_env": "GEE_CREDENTIALS_PATH",
      "service_account_env": "GEE_SERVICE_ACCOUNT"
    }
