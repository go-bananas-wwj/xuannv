"""Round7 Few-Shot 变化检测评估.

冻结 backbone，用 K 个 patch 的标注训练 CD Head，测试其余 patch.
支持多次随机 split 取平均.

用法:
    python scripts/eval/fewshot_change_detection.py \
        --experiment 2 \
        --k-shots 1,5,10,20 \
        --n-splits 5 \
        --device npu:0
"""
from __future__ import annotations

import argparse
import glob
import json
import sys
import time
from pathlib import Path

sys.path.insert(0, "/workspace/xuannv")

import numpy as np
import torch
import torch.nn as nn
import torch.nn.functional as F
import geopandas as gpd
from shapely.geometry import Point
from sklearn.metrics import roc_auc_score
import warnings
warnings.filterwarnings('ignore')

ANNOT_DIR = "/workspace/哈尔滨松北新区变化检测汇总文件/变化检测shp文件"
GRID_PATH = "/workspace/index/harbin/grid/harbin_grid.geojson"
BEFORE_WINDOW = (1688169600000.0, 1703980800000.0)
AFTER_WINDOW = (1719792000000.0, 1735603200000.0)


def find_experiment_files(exp_id: int):
    """自动查找实验的 config 和 checkpoint."""
    config_candidates = glob.glob(f"/workspace/xuannv/configs/round7_8gpu/exp{exp_id}_*.yaml")
    if not config_candidates:
        raise ValueError(f"Config not found for exp{exp_id}")
    config_path = config_candidates[0]

    dirs = glob.glob(f"/workspace/outputs/round7_exp{exp_id}_*")
    if not dirs:
        raise ValueError(f"Output dir not found for exp{exp_id}")
    exp_dir = dirs[0]

    checkpoints = glob.glob(f"{exp_dir}/epoch_*.pt") + glob.glob(f"{exp_dir}/epoch_best_*.pt")
    if not checkpoints:
        raise ValueError(f"Checkpoint not found for exp{exp_id}")
    checkpoint_path = max(checkpoints, key=lambda p: Path(p).stat().st_mtime)

    return config_path, checkpoint_path


def load_backbone(config_path: str, checkpoint_path: str, device: str):
    from src.config import load_config
    from src.models.model import AEFModel
    from src.data.dataset import HarbinPatchDataset
    from src.inference.engine import extract_embedding_map

    cfg = load_config(config_path)
    model = AEFModel(cfg).to(device)
    ckpt = torch.load(checkpoint_path, map_location=device, weights_only=False)
    model.load_state_dict(ckpt["model_state_dict"])
    for p in model.parameters():
        p.requires_grad = False
    model.eval()

    cfg.data.preload = False
    dataset = HarbinPatchDataset(cfg)
    dataset.training = False
    dataset._spatial_augmentation = False
    return model, dataset, extract_embedding_map, cfg


def load_annotations():
    """加载所有标注，返回 {patch_id: [geometry, ...]}."""
    import json as json_mod
    with open(GRID_PATH) as f:
        grid_data = json_mod.load(f)

    patch_bounds = {}
    for feat in grid_data["features"]:
        pid = feat["properties"]["patch_id"]
        coords = feat["geometry"]["coordinates"][0]
        xs = [c[0] for c in coords]
        ys = [c[1] for c in coords]
        patch_bounds[pid] = (min(xs), min(ys), max(xs), max(ys))

    all_changes = []
    for shp_name in ["june.shp", "八月/aug.shp", "September.shp", "October.shp",
                     "SAR建筑工地.shp", "SAR房屋拆除.shp", "SAR非农非粮.shp", "SAR疑似违建.shp"]:
        try:
            gdf = gpd.read_file(f"{ANNOT_DIR}/{shp_name}")
            # ★ FIX: CRS=None 时默认假设为 EPSG:4326 (WGS84)
            if gdf.crs is None:
                gdf = gdf.set_crs("EPSG:4326")
            if gdf.crs.to_epsg() != 32652:
                gdf = gdf.to_crs(epsg=32652)
            for _, row in gdf.iterrows():
                geom = row.geometry
                if geom is None:
                    continue
                if geom.geom_type == "MultiPolygon":
                    geom = list(geom.geoms)[0]
                all_changes.append({"geometry": geom, "patch_id": row.get("patch_id", None)})
        except Exception as e:
            print(f"  跳过 {shp_name}: {e}")

    patch_changes = {}
    for change in all_changes:
        if change["patch_id"]:
            patch_changes.setdefault(change["patch_id"], []).append(change["geometry"])
        else:
            pt = change["geometry"].centroid
            for pid, bounds in patch_bounds.items():
                if bounds[0] <= pt.x <= bounds[2] and bounds[1] <= pt.y <= bounds[3]:
                    patch_changes.setdefault(pid, []).append(change["geometry"])
                    break

    return patch_changes, patch_bounds


def rasterize_annotations(changes, bounds, H=64, W=64):
    resolution = (bounds[2] - bounds[0]) / H
    mask = np.zeros((H, W), dtype=np.float32)
    for geom in changes:
        for row in range(H):
            for col in range(W):
                wx = bounds[0] + (col + 0.5) * resolution
                wy = bounds[3] - (row + 0.5) * resolution
                if geom.contains(Point(wx, wy)):
                    mask[row, col] = 1.0
    return mask


def dice_loss(pred, target, smooth=1.0):
    pred = torch.sigmoid(pred)
    pred_flat = pred.view(pred.size(0), -1)
    target_flat = target.view(target.size(0), -1).float()
    intersection = (pred_flat * target_flat).sum(dim=1)
    union = pred_flat.sum(dim=1) + target_flat.sum(dim=1)
    dice = (2.0 * intersection + smooth) / (union + smooth)
    return 1.0 - dice.mean()


class SimpleCDHead(nn.Module):
    """轻量 2-layer CD Head."""
    def __init__(self, embedding_dim=128, hidden_dim=64):
        super().__init__()
        in_dim = embedding_dim * 4
        self.conv1 = nn.Sequential(
            nn.Conv2d(in_dim, hidden_dim, 1),
            nn.BatchNorm2d(hidden_dim),
            nn.ReLU(inplace=True),
        )
        self.conv2 = nn.Sequential(
            nn.Conv2d(hidden_dim, hidden_dim, 3, padding=1),
            nn.BatchNorm2d(hidden_dim),
            nn.ReLU(inplace=True),
        )
        self.out = nn.Conv2d(hidden_dim, 1, 1)

    def forward(self, emb_before, emb_after):
        diff = emb_before - emb_after
        feat = torch.cat([
            torch.abs(diff),
            emb_before * emb_after,
            emb_before,
            emb_after,
        ], dim=1)
        x = self.conv1(feat)
        x = self.conv2(x)
        return self.out(x)


MIN_CHANGE_PIXELS = 10  # 最小变化像素阈值，过滤过小mask的patch

def extract_all_data(model, dataset, extract_fn, device, patch_infos):
    """提取所有 patch 的 before/after embedding + mask."""
    data = []
    skipped_small = 0
    for pid, pidx, bounds, changes in patch_infos:
        try:
            eb = extract_fn(model, dataset, pidx, BEFORE_WINDOW[0], BEFORE_WINDOW[1], device, normalize=True)
            ea = extract_fn(model, dataset, pidx, AFTER_WINDOW[0], AFTER_WINDOW[1], device, normalize=True)
            mask = rasterize_annotations(changes, bounds)
            n_changed = int(mask.sum())
            if n_changed < MIN_CHANGE_PIXELS:
                skipped_small += 1
                print(f"  跳过 {pid}: mask过小 ({n_changed} pixels < {MIN_CHANGE_PIXELS})")
                continue
            data.append({
                "pid": pid,
                "eb": torch.from_numpy(eb).float(),
                "ea": torch.from_numpy(ea).float(),
                "mask": torch.from_numpy(mask).float(),
            })
        except Exception as e:
            print(f"  跳过 {pid}: {e}")
    print(f"\n过滤后: {len(data)}/{len(patch_infos)} patches (跳过 {skipped_small} 个小mask)")
    return data


def train_cd_head(cd_head, train_data, device, epochs=50, lr=1e-3):
    cd_head = cd_head.to(device)
    optimizer = torch.optim.AdamW(cd_head.parameters(), lr=lr, weight_decay=1e-4)
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=epochs, eta_min=lr/100)

    for epoch in range(epochs):
        cd_head.train()
        np.random.shuffle(train_data)
        train_loss = 0.0
        for item in train_data:
            eb = item["eb"].unsqueeze(0).to(device)
            ea = item["ea"].unsqueeze(0).to(device)
            mask = item["mask"].unsqueeze(0).unsqueeze(0).to(device)

            pred = cd_head(eb, ea)
            loss_bce = F.binary_cross_entropy_with_logits(pred, mask)
            loss_dice = dice_loss(pred, mask)
            loss = loss_bce + loss_dice

            optimizer.zero_grad()
            loss.backward()
            torch.nn.utils.clip_grad_norm_(cd_head.parameters(), 1.0)
            optimizer.step()
            train_loss += loss.item()

        scheduler.step()

    return cd_head


def evaluate_cd_head(cd_head, test_data, device):
    cd_head.eval()
    per_patch_results = []
    all_preds = []
    all_masks = []

    with torch.no_grad():
        for item in test_data:
            eb = item["eb"].unsqueeze(0).to(device)
            ea = item["ea"].unsqueeze(0).to(device)
            mask = item["mask"].numpy()
            pred = cd_head(eb, ea)
            pred_prob = torch.sigmoid(pred).cpu().numpy()[0, 0]

            # 过滤无效 patch
            changed_pixels = mask.sum()
            unchanged_pixels = (1 - mask).sum()
            if changed_pixels > 10 and unchanged_pixels > 10:
                patch_auc = roc_auc_score(mask.flatten(), pred_prob.flatten())
            else:
                patch_auc = None

            per_patch_results.append({
                "pid": item["pid"],
                "auc": patch_auc,
                "changed_pixels": int(changed_pixels),
                "unchanged_pixels": int(unchanged_pixels),
            })
            all_preds.extend(pred_prob.flatten().tolist())
            all_masks.extend(mask.flatten().tolist())

    # 全局 AUC
    all_preds = np.array(all_preds)
    all_masks = np.array(all_masks)
    global_auc = roc_auc_score(all_masks, all_preds) if len(np.unique(all_masks)) > 1 else 0.0

    valid_aucs = [r["auc"] for r in per_patch_results if r["auc"] is not None]
    mean_auc = np.mean(valid_aucs) if valid_aucs else 0.0

    return {
        "global_auc": float(global_auc),
        "mean_patch_auc": float(mean_auc),
        "n_valid_patches": len(valid_aucs),
        "per_patch": per_patch_results,
    }


def run_fewshot_experiment(all_data, k_shot, n_splits, embedding_dim, device):
    """运行一次 K-shot few-shot 实验，重复 n_splits 次."""
    n_total = len(all_data)
    if k_shot >= n_total:
        k_shot = max(1, n_total // 2)

    split_results = []
    for split_idx in range(n_splits):
        # 随机划分
        indices = list(range(n_total))
        np.random.shuffle(indices)
        train_idx = indices[:k_shot]
        test_idx = indices[k_shot:]

        train_data = [all_data[i] for i in train_idx]
        test_data = [all_data[i] for i in test_idx]

        # 训练
        cd_head = SimpleCDHead(embedding_dim=embedding_dim, hidden_dim=64)
        cd_head = train_cd_head(cd_head, train_data, device, epochs=50, lr=1e-3)

        # 评估
        result = evaluate_cd_head(cd_head, test_data, device)
        result["split"] = split_idx
        result["k_shot"] = k_shot
        result["n_train"] = len(train_data)
        result["n_test"] = len(test_data)
        split_results.append(result)

    # 汇总
    valid_global_aucs = [r["global_auc"] for r in split_results if r["n_valid_patches"] > 0]
    valid_mean_aucs = [r["mean_patch_auc"] for r in split_results if r["n_valid_patches"] > 0]

    return {
        "k_shot": k_shot,
        "n_splits": n_splits,
        "global_auc_mean": float(np.mean(valid_global_aucs)) if valid_global_aucs else 0.0,
        "global_auc_std": float(np.std(valid_global_aucs)) if valid_global_aucs else 0.0,
        "mean_patch_auc_mean": float(np.mean(valid_mean_aucs)) if valid_mean_aucs else 0.0,
        "mean_patch_auc_std": float(np.std(valid_mean_aucs)) if valid_mean_aucs else 0.0,
        "splits": split_results,
    }


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--experiment", type=int, default=None, help="实验 ID (1-8)")
    parser.add_argument("--config", type=str, default=None, help="直接指定 config 路径")
    parser.add_argument("--checkpoint", type=str, default=None, help="直接指定 checkpoint 路径")
    parser.add_argument("--k-shots", type=str, default="1,5,10,20", help="K-shot 列表，逗号分隔")
    parser.add_argument("--n-splits", type=int, default=5, help="每个 K 的随机 split 次数")
    parser.add_argument("--device", type=str, default="npu:0")
    parser.add_argument("--output", type=str, default=None)
    parser.add_argument("--seed", type=int, default=42)
    args = parser.parse_args()

    torch.manual_seed(args.seed)
    np.random.seed(args.seed)

    k_shots = [int(x.strip()) for x in args.k_shots.split(",")]

    if args.config and args.checkpoint:
        config_path = args.config
        checkpoint_path = args.checkpoint
        exp_name = Path(config_path).stem
    elif args.experiment:
        print("=" * 70)
        print(f" Few-Shot 变化检测评估 — exp{args.experiment}")
        print("=" * 70)
        print("\n[1/4] 查找实验文件...")
        config_path, checkpoint_path = find_experiment_files(args.experiment)
        exp_name = f"exp{args.experiment}"
    else:
        parser.error("必须提供 --experiment 或同时提供 --config 和 --checkpoint")

    print(f"  Config: {config_path}")
    print(f"  Checkpoint: {checkpoint_path}")

    # 加载 backbone
    print("\n[2/4] 加载冻结的 backbone...")
    model, dataset, extract_fn, cfg = load_backbone(config_path, checkpoint_path, args.device)
    print(f"  Dataset: {len(dataset)} patches, Embedding dim: {cfg.model.embedding_dim}")

    # 加载标注
    print("\n[3/4] 加载标注数据...")
    patch_changes, patch_bounds = load_annotations()

    patch_infos = []
    for pid, changes in patch_changes.items():
        if pid not in dataset.patches:
            continue
        patch_infos.append((pid, dataset.patches.index(pid), patch_bounds[pid], changes))

    print(f"  有效标注 patch: {len(patch_infos)}")
    if len(patch_infos) < 5:
        print("  标注 patch 太少，无法评估")
        return

    # 提取 embedding
    print(f"\n[4/4] 提取 embedding...")
    all_data = extract_all_data(model, dataset, extract_fn, args.device, patch_infos)
    print(f"  成功提取 {len(all_data)} 个 patch")

    # 运行 few-shot 实验
    print(f"\n{'='*70}")
    print(" Few-Shot 实验")
    print(f"{'='*70}")

    k_results = []
    for k in k_shots:
        print(f"\n--- K={k} ---")
        result = run_fewshot_experiment(all_data, k, args.n_splits, cfg.model.embedding_dim, args.device)
        print(f"  Global AUC: {result['global_auc_mean']:.4f} ± {result['global_auc_std']:.4f}")
        print(f"  Patch AUC:  {result['mean_patch_auc_mean']:.4f} ± {result['mean_patch_auc_std']:.4f}")
        k_results.append(result)

    # 保存结果
    output_data = {
        "experiment": args.experiment,
        "checkpoint": checkpoint_path,
        "config": config_path,
        "n_annotated_patches": len(all_data),
        "k_shots": k_shots,
        "n_splits": args.n_splits,
        "results": k_results,
    }

    if args.output is None:
        args.output = f"/workspace/outputs/round7_downstream_eval/exp{args.experiment}_cd_fewshot.json"
    Path(args.output).parent.mkdir(parents=True, exist_ok=True)
    with open(args.output, "w") as f:
        json.dump(output_data, f, indent=2, ensure_ascii=False)
    print(f"\n📄 结果保存: {args.output}")

    # 汇总表
    print(f"\n{'='*70}")
    print(" 汇总")
    print(f"{'='*70}")
    print(f"{'K-shot':<10} {'Global AUC':<20} {'Patch AUC':<20}")
    print("-" * 70)
    for r in k_results:
        print(f"K={r['k_shot']:<3} {r['global_auc_mean']:.4f}±{r['global_auc_std']:.4f}     {r['mean_patch_auc_mean']:.4f}±{r['mean_patch_auc_std']:.4f}")
    print("=" * 70)


if __name__ == "__main__":
    main()
